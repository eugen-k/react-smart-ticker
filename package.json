{
  "name": "react-smart-ticker",
  "version": "1.6.10",
  "author": "Eugen Korolev <eugen.korolev@gmail.com>",
  "license": "MIT",
  "description": "Transforms child elements into a \"smart\", optionally draggable ticker (marquee)",
  "keywords": [
    "ticker",
    "marquee",
    "react-component",
    "reactjs",
    "slider",
    "ticker",
    "ellipsis",
    "draggable"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugen-k/react-smart-ticker.git"
  },
  "bugs": {
    "url": "https://github.com/eugen-k/react-smart-ticker/issues"
  },
  "homepage": "https://github.com/eugen-k/react-smart-ticker#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "rollup -c -w",
    "build": "rm -rf dist && yarn run build:js && yarn build:types",
    "build:js": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "test-watch": "jest --watch",
    "test": "jest --coverage",
    "lint": "eslint ./src"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@eslint/compat": "^1.2.6",
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "postcss-preset-env": "^10.1.4",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "~1.83.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.3.0",
    "tslint-react": "^5.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "~8.24.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {},
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./SmartTicker": {
      "import": "./dist/components/SmartTicker.esm.js",
      "require": "./dist/components/SmartTicker.js",
      "types": "./dist/components/SmartTicker.d.ts"
    },
    "./SmartTickerDraggable": {
      "import": "./dist/components/SmartTickerDraggable.esm.js",
      "require": "./dist/components/SmartTickerDraggable.js",
      "types": "./dist/components/SmartTickerDraggable.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "SmartTicker": [
        "dist/components/SmartTicker/index.d.ts"
      ],
      "SmartTickerDraggable": [
        "dist/components/SmartTickerDraggable/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "resolutions": {
    "string-width": "4.2.3",
    "wrap-ansi": "7.0.0"
  }
}
